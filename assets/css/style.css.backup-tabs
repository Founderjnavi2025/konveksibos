:root {
  --bg: #f4f6f8;
  --white: #ffffff;
  --ink: #17212b;
  --muted: #778391;
  --line: #e7ebef;
  --navy: #172b4d;
  --blue: #3569e8;
  --blue-soft: #edf2ff;
  --green: #16845b;
  --green-soft: #e9f7f0;
  --amber: #a66b10;
  --amber-soft: #fff5df;
  --shadow: 0 8px 26px rgba(25,42,65,.045);
}

* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font-family: Inter, system-ui, -apple-system, sans-serif;
  font-size: 14px;
  line-height: 1.5;
}

button {
  font: inherit;
  cursor: pointer;
}

.app {
  min-height: 100vh;
  display: grid;
  grid-template-columns: 248px minmax(0,1fr);
}

.sidebar {
  background: var(--white);
  border-right: 1px solid var(--line);
  padding: 24px 16px;
  display: flex;
  flex-direction: column;
  gap: 28px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 11px;
  padding: 0 10px;
}

.brand-mark {
  width: 38px;
  height: 38px;
  border-radius: 11px;
  background: var(--navy);
  color: white;
  display: grid;
  place-items: center;
  font-weight: 800;
}

.brand strong {
  font-size: 15px;
}

.brand small {
  display: block;
  color: var(--muted);
  font-size: 11px;
}

.nav-label {
  color: #9aa4af;
  font-size: 10px;
  font-weight: 750;
  letter-spacing: 1.1px;
  padding: 0 12px;
  margin-bottom: 8px;
}

.navigation {
  display: grid;
  gap: 4px;
}

.navigation button {
  border: 0;
  background: transparent;
  color: #687482;
  text-align: left;
  padding: 11px 12px;
  border-radius: 9px;
  font-weight: 550;
}

.navigation button:hover {
  background: #f5f7fa;
  color: var(--ink);
}

.navigation button.active {
  background: var(--blue-soft);
  color: var(--blue);
  font-weight: 700;
}

.workspace {
  margin-top: auto;
  padding: 14px;
  background: #f7f9fb;
  border: 1px solid var(--line);
  border-radius: 12px;
}

.workspace small {
  color: var(--muted);
  font-size: 10px;
}

.workspace strong {
  display: block;
  margin: 5px 0;
}

.workspace span {
  color: var(--green);
  font-size: 11px;
}

.main {
  min-width: 0;
}

.topbar {
  height: 70px;
  background: rgba(255,255,255,.92);
  border-bottom: 1px solid var(--line);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 36px;
  position: sticky;
  top: 0;
  z-index: 5;
  color: var(--muted);
  font-size: 12px;
}

.topbar strong {
  color: var(--ink);
}

.profile {
  display: flex;
  align-items: center;
  gap: 13px;
}

.profile span {
  padding: 8px 11px;
  border: 1px solid var(--line);
  border-radius: 8px;
  color: #526071;
}

.profile b {
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: #e8edf5;
  color: var(--navy);
  display: grid;
  place-items: center;
}

.content {
  max-width: 1400px;
  margin: auto;
  padding: 32px 36px 55px;
}

.page-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 18px;
  margin-bottom: 25px;
}

.page-heading small {
  color: var(--blue);
  font-weight: 750;
  font-size: 10px;
  letter-spacing: 1.1px;
}

h1 {
  font-size: 27px;
  letter-spacing: -.8px;
  margin: 5px 0;
}

.page-heading p {
  margin: 0;
  color: var(--muted);
  font-size: 13px;
}

.primary {
  border: 0;
  background: var(--blue);
  color: white;
  padding: 11px 16px;
  border-radius: 9px;
  font-weight: 650;
}

.primary:hover {
  background: #2859d0;
}

.metrics {
  display: grid;
  grid-template-columns: repeat(4,minmax(0,1fr));
  gap: 14px;
  margin-bottom: 20px;
}

.metric {
  background: var(--white);
  border: 1px solid var(--line);
  border-radius: 13px;
  padding: 17px 18px;
  box-shadow: var(--shadow);
}

.metric > span {
  color: var(--muted);
  font-size: 12px;
}

.metric strong {
  display: block;
  font-size: 25px;
  letter-spacing: -.8px;
  margin: 10px 0 2px;
}

.metric strong small {
  font-size: 12px;
  color: var(--muted);
}

.metric p {
  color: var(--muted);
  font-size: 11px;
  margin: 0;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: minmax(0,1.55fr) minmax(290px,.9fr);
  gap: 16px;
}

.panel {
  background: var(--white);
  border: 1px solid var(--line);
  border-radius: 13px;
  box-shadow: var(--shadow);
  min-width: 0;
}

.panel-heading {
  padding: 18px 20px;
  border-bottom: 1px solid var(--line);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.panel-heading h2 {
  font-size: 14px;
  margin: 0;
}

.panel-heading p {
  color: var(--muted);
  font-size: 11px;
  margin: 3px 0 0;
}

.text-button {
  color: var(--blue);
  font-size: 11px;
  font-weight: 700;
  border: 0;
  background: none;
}

.table-scroll {
  overflow-x: auto;
}

table {
  width: 100%;
  border-collapse: collapse;
  white-space: nowrap;
}

th {
  background: #fbfcfd;
  color: #8a95a2;
  text-align: left;
  font-size: 10px;
  letter-spacing: .6px;
  text-transform: uppercase;
}

th, td {
  padding: 14px 20px;
  border-bottom: 1px solid #eef1f4;
}

td {
  font-size: 12px;
  color: #43505e;
}

td strong {
  color: var(--ink);
}

.status {
  display: inline-flex;
  padding: 4px 8px;
  border-radius: 20px;
  font-size: 10px;
  font-weight: 700;
}

.done {
  background: var(--green-soft);
  color: var(--green);
}

.progress {
  background: var(--blue-soft);
  color: var(--blue);
}

.waiting {
  background: var(--amber-soft);
  color: var(--amber);
}

.side-panels {
  display: grid;
  gap: 16px;
  align-content: start;
}

.finance {
  padding: 18px 20px;
}

.finance > span {
  color: var(--muted);
  font-size: 11px;
}

.finance > strong {
  display: block;
  font-size: 26px;
  letter-spacing: -.7px;
  margin: 5px 0 15px;
}

.finance div {
  display: flex;
  justify-content: space-between;
  padding: 10px 0;
  border-top: 1px solid var(--line);
  font-size: 12px;
}

.finance div span {
  color: var(--muted);
}

.progress-list {
  padding: 18px 20px;
  display: grid;
  gap: 16px;
}

.progress-list p {
  display: flex;
  justify-content: space-between;
  margin: 0 0 7px;
  font-size: 11px;
}

.progress-list p b {
  color: var(--muted);
}

.track {
  height: 6px;
  background: #edf0f3;
  border-radius: 9px;
  overflow: hidden;
}

.track i {
  height: 100%;
  display: block;
  background: var(--blue);
  border-radius: 9px;
}

.mobile-nav {
  display: none;
}

@media(max-width:1050px) {
  .metrics {
    grid-template-columns: repeat(2,minmax(0,1fr));
  }

  .dashboard-grid {
    grid-template-columns: 1fr;
  }

  .side-panels {
    grid-template-columns: repeat(2,minmax(0,1fr));
  }
}

@media(max-width:700px) {
  .app {
    display: block;
  }

  .sidebar {
    display: none;
  }

  .topbar {
    height: 58px;
    padding: 0 15px;
  }

  .profile {
    gap: 8px;
  }

  .profile span {
    font-size: 10px;
    padding: 7px;
  }

  .profile b {
    width: 30px;
    height: 30px;
  }

  .content {
    padding: 23px 15px 95px;
  }

  .page-heading {
    flex-direction: column;
    align-items: stretch;
    margin-bottom: 19px;
  }

  h1 {
    font-size: 24px;
  }

  .primary {
    width: 100%;
  }

  .metrics {
    gap: 9px;
  }

  .metric {
    padding: 13px;
    border-radius: 11px;
  }

  .metric > span {
    font-size: 10px;
  }

  .metric strong {
    font-size: 21px;
    margin: 8px 0 2px;
  }

  .dashboard-grid {
    gap: 12px;
  }

  .side-panels {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .panel-heading {
    padding: 15px;
  }

  th, td {
    padding: 12px 14px;
  }

  .mobile-nav {
    display: grid;
    grid-template-columns: repeat(5,1fr);
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 10;
    background: rgba(255,255,255,.96);
    border-top: 1px solid var(--line);
    padding: 9px 4px calc(9px + env(safe-area-inset-bottom));
  }

  .mobile-nav button {
    border: 0;
    background: none;
    color: #8994a1;
    font-size: 10px;
    padding: 5px 0;
  }

  .mobile-nav button.active {
    color: var(--blue);
    font-weight: 750;
  }
}

.worker-form-panel,
.worker-list-panel {
  margin-bottom: 20px;
}

.worker-form {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18px;
  margin-top: 20px;
}

.worker-form label {
  display: grid;
  gap: 7px;
  color: #536170;
  font-size: 12px;
  font-weight: 650;
}

.worker-form input,
.worker-form select {
  width: 100%;
  min-height: 43px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fff;
  padding: 0 12px;
  color: var(--ink);
  font: inherit;
  outline: none;
}

.worker-form input:focus,
.worker-form select:focus {
  border-color: var(--blue);
}

.worker-form-actions {
  display: flex;
  align-items: center;
  gap: 10px;
  grid-column: 1 / -1;
}

.secondary {
  border: 1px solid var(--line);
  background: white;
  color: var(--ink);
  padding: 10px 16px;
  border-radius: 8px;
}

.worker-actions {
  display: flex;
  gap: 12px;
}

.danger {
  color: #c03939;
}

.empty-state {
  padding: 38px 15px;
  text-align: center;
  color: var(--muted);
}

.empty-state strong {
  color: var(--ink);
}

.empty-state p {
  margin-bottom: 0;
}

@media (max-width: 650px) {
  .worker-form {
    grid-template-columns: 1fr;
  }

  .worker-form-actions {
    grid-column: auto;
  }
}

/* Form input contrast refinement */
.worker-form input,
.worker-form select {
  background: #f8fafc;
  border: 1px solid #cbd5e1;
  color: #17212b;
  border-radius: 9px;
  min-height: 46px;
  padding: 0 13px;
  box-shadow: inset 0 1px 2px rgba(15, 23, 42, .04);
}

.worker-form input::placeholder {
  color: #9aa5b1;
}

.worker-form input:hover,
.worker-form select:hover {
  border-color: #94a3b8;
}

.worker-form input:focus,
.worker-form select:focus {
  background: #ffffff;
  border: 1px solid #3569e8;
  box-shadow: 0 0 0 3px rgba(53, 105, 232, .12);
  outline: none;
}

.worker-form label {
  color: #344255;
  font-weight: 650;
}

.worker-form small {
  color: var(--muted);
}

#jobTable td {
  vertical-align: middle;
}

#jobTable td small {
  color: var(--muted);
  font-size: 11px;
}
